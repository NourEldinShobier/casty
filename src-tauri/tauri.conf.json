{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Casty",
  "version": "0.2.1",
  "identifier": "dev.casty.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Casty",
        "url": "index.html",
        "width": 640,
        "height": 400,
        "minWidth": 320,
        "minHeight": 214,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
